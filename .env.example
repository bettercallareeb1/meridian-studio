# Copy this file to .env.local for local development, or add the same
# variables in your hosting provider's dashboard for production.
#
# Public site URL used for canonical links and social previews.
# Set this to your custom domain when you attach one.
NEXT_PUBLIC_APP_URL=https://your-domain.com
#
# Neon: use the POOLED connection string for the running app.
# For `drizzle-kit push`, use the DIRECT (unpooled) connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_BRANCH=production

# Neon Object Storage (S3-compatible). `neon deploy` writes these for you.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_ENDPOINT_URL_S3=https://your-branch.storage.neon.tech
AWS_REGION=your-region
